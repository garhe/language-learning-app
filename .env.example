PORT=3000

# Option A: Azure AI Foundry Target URI (recommended if you have Target URI + Key)
AZURE_FOUNDRY_TARGET_URI=https://YOUR-RESOURCE.services.ai.azure.com/api/projects/YOUR-PROJECT/openai/v1/responses
AZURE_FOUNDRY_KEY=YOUR_FOUNDRY_KEY
AZURE_FOUNDRY_MODEL=gpt-5.4-mini

# Option B: Classic Azure OpenAI endpoint + deployment
AZURE_OPENAI_ENDPOINT=https://YOUR-RESOURCE-NAME.openai.azure.com
AZURE_OPENAI_API_KEY=YOUR_AZURE_OPENAI_API_KEY
AZURE_OPENAI_API_VERSION=2024-10-21
AZURE_OPENAI_CHAT_DEPLOYMENT=gpt-4.1-mini

# Azure Speech
AZURE_SPEECH_KEY=YOUR_AZURE_SPEECH_KEY
AZURE_SPEECH_REGION=eastus
